rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['farmer', 'buyer', 'certifier', 'admin'] &&
             data.createdAt is string;
    }

    function isValidFarmer(data) {
      return data.keys().hasAll(['farmerId', 'name', 'certificationStatus']) &&
             data.farmerId is string && data.farmerId.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.certificationStatus in ['none', 'pending', 'certified', 'expired'];
    }

    function isValidBatch(data) {
      return data.keys().hasAll(['batchId', 'farmerId', 'cropType', 'harvestDate', 'status', 'quantity']) &&
             data.batchId is string && data.batchId.size() <= 128 &&
             data.farmerId is string && data.farmerId.size() <= 128 &&
             data.cropType is string && data.cropType.size() <= 128 &&
             data.harvestDate is string &&
             data.status in ['harvested', 'distributing', 'market', 'consumed'] &&
             data.quantity is string;
    }

    // Connectivity test
    match /test/connection {
      allow get: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Farmers collection
    match /farmers/{farmerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == farmerId;
    }

    // Batches collection
    match /batches/{batchId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidBatch(incoming()) && (incoming().farmerId == request.auth.uid);
      allow update: if isSignedIn() && isValidBatch(incoming()) && (existing().farmerId == request.auth.uid);
      allow delete: if isSignedIn() && existing().farmerId == request.auth.uid;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}

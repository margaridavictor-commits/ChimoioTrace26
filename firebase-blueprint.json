{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and role within the AgroTrace platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "role": { "type": "string", "enum": ["farmer", "buyer", "certifier", "admin"], "description": "System role" },
        "phoneNumber": { "type": "string", "description": "Contact phone number" },
        "province": { "type": "string", "description": "Geographical province" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp" },
        "photoUrl": { "type": "string", "description": "URL to profile photo" }
      },
      "required": ["uid", "email", "role", "displayName", "createdAt"]
    },
    "Farmer": {
      "title": "Farmer Profile",
      "description": "Detailed information about a specific farmer profiles",
      "type": "object",
      "properties": {
        "farmerId": { "type": "string", "description": "Matches User UID" },
        "name": { "type": "string", "description": "Full name or farm name" },
        "location": { "type": "object", "description": "Geographic coordinates {lat, lng}" },
        "province": { "type": "string", "description": "Province of operation" },
        "certificationStatus": { "type": "string", "enum": ["none", "pending", "certified", "expired"], "description": "Global GAP status" },
        "gapId": { "type": "string", "description": "Global GAP Identifier" },
        "photoUrl": { "type": "string", "description": "Profile or farm image" },
        "phoneNumber": { "type": "string", "description": "Contact number" },
        "bio": { "type": "string", "description": "Short biography or farm description" }
      },
      "required": ["farmerId", "name", "certificationStatus"]
    },
    "Batch": {
      "title": "Product Batch",
      "description": "A specific harvest batch of agricultural product",
      "type": "object",
      "properties": {
        "batchId": { "type": "string" },
        "farmerId": { "type": "string" },
        "cropType": { "type": "string" },
        "harvestDate": { "type": "string", "format": "date" },
        "quantity": { "type": "string" },
        "location": { "type": "object" },
        "status": { "type": "string", "enum": ["harvested", "distributing", "market", "consumed"] },
        "certificationId": { "type": "string" },
        "journey": { "type": "array" },
        "qrCode": { "type": "string" }
      },
      "required": ["batchId", "farmerId", "cropType", "harvestDate"]
    },
    "AuditLog": {
      "title": "Certification Audit",
      "description": "Records of compliance audits for Global GAP",
      "type": "object",
      "properties": {
        "logId": { "type": "string" },
        "farmerId": { "type": "string" },
        "certifierId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "result": { "type": "string", "enum": ["pass", "fail", "needs_improvement"] },
        "notes": { "type": "string" }
      },
      "required": ["logId", "farmerId", "certifierId", "date", "result"]
    },
    "FarmerView": {
      "title": "Farmer View Log",
      "description": "Log of consumer users who have viewed a farmer's batches",
      "type": "object",
      "properties": {
        "viewId": { "type": "string" },
        "userId": { "type": "string" },
        "farmerId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["viewId", "userId", "farmerId", "viewedAt"]
    },
    "Notification": {
      "title": "Notification Log",
      "description": "Consumer notifications for newly added batches from viewed farmers",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "cropType": { "type": "string" },
        "batchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["notificationId", "targetUserId", "farmerId", "cropType", "batchId", "createdAt", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/farmers/{farmerId}": {
      "schema": "Farmer",
      "description": "Farmer profiles and locations"
    },
    "/batches/{batchId}": {
      "schema": "Batch",
      "description": "Traceability batches"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Certification audits"
    },
    "/farmer_views/{viewId}": {
      "schema": "FarmerView",
      "description": "Tracks consumer views on farmer products"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Holds notifications for logged-in consumers"
    }
  }
}
